<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add My Project</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Poppins", sans-serif;
        background-color: #f8f9fa;
      }
      .form-section {
        background-color: #e5eaf1;
        padding: 50px 0;
      }
      .form-control,
      .form-check-input {
        box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.05);
      }
      .btn-submit {
        background-color: #191825;
        color: white;
        border-radius: 20px;
        padding: 6px 30px;
        text-transform: lowercase;
        font-weight: bold;
      }
      .project-section {
        padding: 60px 0;
        background-color: #fff;
      }
      .card-body img.tech-icon {
        width: 24px;
        margin-right: 8px;
      }
      .card-buttons button {
        border-radius: 20px;
        margin: 0 5px;
      }
      .card {
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        border: none;
      }
      .fixed-img {
        height: 200px;
        object-fit: cover;
      }

      .button-main {
        display: flex;
        width: 100%;
        gap: 10px;
        justify-content: space-between;
      }

      .btn-dark {
        width: 50%;
      }
    </style>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom">
      <div class="container">
        <a class="navbar-brand fw-bold" href="#"
          ><img src="./assets/icons/logo-dumbways.png" width="35" />
        </a>
        <div class="collapse navbar-collapse">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <a class="nav-link" href="#">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#">My Project</a>
            </li>
          </ul>
          <a href="#" class="btn btn-dark">Contact Me</a>
        </div>
      </div>
    </nav>

    <div class="form-section">
      <div class="container">
        <h3 class="text-center fw-bold mb-5">ADD MY PROJECT</h3>
        <form onsubmit="getData(event)">
          <div class="mb-3">
            <label class="form-label">Project Name</label>
            <input type="text" class="form-control" id="project-name" />
          </div>
          <div class="row g-3 mb-3">
            <div class="col">
              <label class="form-label">Start Date</label>
              <input type="date" class="form-control" id="start-date" />
            </div>
            <div class="col">
              <label class="form-label">End Date</label>
              <input type="date" class="form-control" id="end-date" />
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea class="form-control" id="description" rows="5"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">Technologies</label>
            <div class="row">
              <div class="col-6">
                <div class="form-check mb-2">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    value="nodejs"
                    id="techNode"
                  />
                  <label class="form-check-label" for="techNode">Node Js</label>
                </div>
                <div class="form-check mb-2">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    value="reactjs"
                    id="techReact"
                  />
                  <label class="form-check-label" for="techReact"
                    >React Js</label
                  >
                </div>
              </div>
              <div class="col-6">
                <div class="form-check mb-2">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    value="nextjs"
                    id="techNext"
                  />
                  <label class="form-check-label" for="techNext">Next Js</label>
                </div>
                <div class="form-check mb-2">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    value="typescript"
                    id="techTS"
                  />
                  <label class="form-check-label" for="techTS"
                    >TypeScript</label
                  >
                </div>
              </div>
            </div>
          </div>
          <div class="mb-4">
            <label for="project-image" class="form-label">Upload Image</label>
            <input
              class="form-control"
              type="file"
              accept="image/*"
              id="project-image"
            />
          </div>
          <div class="text-end">
            <button type="submit" class="btn btn-submit">submit</button>
          </div>
        </form>
      </div>
    </div>

    <div class="project-section">
      <div class="container">
        <h3 class="text-center fw-bold mb-5">MY PROJECT</h3>
        <div id="cardContainer" class="row row-cols-1 row-cols-md-3 g-4"></div>
      </div>
    </div>

    <script>
      const projects = [];

      function getData(e) {
        e.preventDefault();

        const name = document.getElementById("project-name").value;
        const start = Date.parse(document.getElementById("start-date").value);
        const end = Date.parse(document.getElementById("end-date").value);
        const desc = document.getElementById("description").value;
        const node = document.getElementById("techNode").checked;
        const react = document.getElementById("techReact").checked;
        const next = document.getElementById("techNext").checked;
        const typescript = document.getElementById("techTS").checked;
        const imageFile = document.getElementById("project-image").files[0];

        if (!name || !desc || !imageFile) {
          alert("Please fill all fields");
          return;
        }

        const duration = Math.round((end - start) / (1000 * 60 * 60 * 24 * 30));

        const reader = new FileReader();
        reader.onload = function (event) {
          const newProject = {
            name,
            duration,
            desc,
            techs: { node, react, next, typescript },
            img: event.target.result,
          };
          projects.push(newProject);
          renderCards();
        };

        reader.readAsDataURL(imageFile);
      }

      function renderCards() {
        const container = document.getElementById("cardContainer");
        container.innerHTML = "";

        projects.forEach((p) => {
          container.innerHTML += `
          <div class="col">
            <div class="card">
              <img src="${p.img}" class="card-img-top fixed-img" alt="${
            p.name
          }" />
              <div class="card-body">
                <h5 class="card-title">${
                  p.name
                } - ${new Date().getFullYear()}</h5>
                <p class="card-text">durasi: ${p.duration} bulan</p>
                <p class="card-text">${p.desc}</p>
                <div>
                  ${
                    p.techs.node
                      ? '<img class="tech-icon" src="./assets/icons/node.png" />'
                      : ""
                  }
                  ${
                    p.techs.react
                      ? '<img class="tech-icon" src="./assets/icons/react.png" />'
                      : ""
                  }
                  ${
                    p.techs.next
                      ? '<img class="tech-icon" src="./assets/icons/next.png" />'
                      : ""
                  }
                  ${
                    p.techs.typescript
                      ? '<img class="tech-icon" src="./assets/icons/typescript.png" />'
                      : ""
                  }
                </div>
              </div>
              <div class="card-footer d-flex">
                <div class="button-main">
                <button class="btn btn-dark btn-sm">edit</button>
                <button class="btn btn-dark btn-sm ms-2">delete</button>
                </div>
              </div>
            </div>
          </div>
          `;
        });
      }
    </script>
  </body>
</html>